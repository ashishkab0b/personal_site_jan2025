# Existing mail/contact settings
MAIL_USERNAME=
MAIL_PASSWORD=
MAILTRAP_API_TOKEN=
MAIL_SUPPORT_RECIPIENT=
RECAPTCHA_SECRET_KEY=

# Flask session signing. Use a long random value in production.
SECRET_KEY=

# Generate with:
# python scripts/generate_admin_password_hash.py
ADMIN_PASSWORD_HASH=

# Docker production defaults
ANALYTICS_DB_PATH=/app/data/analytics.sqlite3
MAXMIND_DB_DIR=/app/data/geoip
NGINX_ACCESS_LOG_PATH=/app/nginx_logs/access.log

# Used by ../scripts/update_maxmind.sh
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# Optional override; defaults to "GeoLite2-City GeoLite2-ASN"
GEOIPUPDATE_EDITION_IDS=
